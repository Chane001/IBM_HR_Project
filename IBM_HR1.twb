      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Attrition:nk]' palette='red_10_0' type='palette'>
            <map to='#f26250'>
              <bucket>&quot;Yes&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:Department:nk]' palette='brown_10_0' type='palette'>
            <map to='#9f3632'>
              <bucket>&quot;Sales&quot;</bucket>
            </map>
            <map to='#d18954'>
              <bucket>&quot;Research &amp; Development&quot;</bucket>
            </map>
            <map to='#eedbbd'>
              <bucket>&quot;Human Resources&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:JobRole:nk]' palette='purple_10_0' type='palette'>
            <map to='#7c4d79'>
              <bucket>&quot;Research Director&quot;</bucket>
            </map>
            <map to='#885b88'>
              <bucket>&quot;Manager&quot;</bucket>
            </map>
            <map to='#986995'>
              <bucket>&quot;Healthcare Representative&quot;</bucket>
            </map>
            <map to='#ac769d'>
              <bucket>&quot;Manufacturing Director&quot;</bucket>
            </map>
            <map to='#bc86a9'>
              <bucket>&quot;Research Scientist&quot;</bucket>
            </map>
            <map to='#c995b7'>
              <bucket>&quot;Sales Executive&quot;</bucket>
            </map>
            <map to='#d6a6c6'>
              <bucket>&quot;Human Resources&quot;</bucket>
            </map>
            <map to='#e4b6d6'>
              <bucket>&quot;Laboratory Technician&quot;</bucket>
            </map>
            <map to='#eec9e5'>
              <bucket>&quot;Sales Representative&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:EnvironmentSatisfaction:ok]' palette='sf_sunrise' type='palette'>
            <map to='#ce6716'>
              <bucket>4</bucket>
            </map>
            <map to='#f59623'>
              <bucket>3</bucket>
            </map>
            <map to='#f5c062'>
              <bucket>2</bucket>
            </map>
            <map to='#f5de98'>
              <bucket>1</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:JobInvolvement:ok]' palette='sf_bluegrass' type='palette'>
            <map to='#27aab0'>
              <bucket>4</bucket>
            </map>
            <map to='#51d2bb'>
              <bucket>3</bucket>
            </map>
            <map to='#94e7a8'>
              <bucket>2</bucket>
            </map>
            <map to='#c7f296'>
              <bucket>1</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:MonthlyIncomeBrackets:nk]' palette='purple_10_0' type='palette'>
            <map to='#7c4d79'>
              <bucket>&quot;High Income&quot;</bucket>
            </map>
            <map to='#986995'>
              <bucket>&quot;Upper-middle Income&quot;</bucket>
            </map>
            <map to='#bc86a9'>
